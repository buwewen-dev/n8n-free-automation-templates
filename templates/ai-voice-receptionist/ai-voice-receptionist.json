    },
    {
      "parameters": {
        "jsCode": "// Works out which days to read from the calendar: the requested day (or today) plus the next week,\n// so one calendar read can answer \"what's free\" and \"book this time\" without a second lookup.\nconst s = $('Your Settings').first().json;\nconst r = $('Read The Request').first().json;\nconst tz = s.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\nconst raw = String(r.args.date || r.args.day || (r.args.start || '').slice(0, 10) || '').trim();\nlet day = now.startOf('day');\nif (/^\\d{4}-\\d{2}-\\d{2}/.test(raw)) { const d = DateTime.fromISO(raw.slice(0, 10), { zone: tz }); if (d.isValid) day = d.startOf('day'); }\nelse if (/tomorrow/i.test(raw)) day = now.plus({ days: 1 }).startOf('day');\nconst pastAsked = day < now.startOf('day') ? day.toFormat('LLLL d') : '';      // remember it, to say so\nif (pastAsked) day = now.startOf('day');                                       // never look into the past\nconst ahead = Math.max(1, Math.min(30, parseInt(s.daysToSearch, 10) || 7));\nreturn [{ json: { windowStart: day.toISO(), windowEnd: day.plus({ days: ahead }).endOf('day').toISO(), requestedDay: day.toISODate(), pastAsked } }];\n"
      },
      "id": "d12887e7-ffc2-4535-b64a-9c12251cf852",
      "name": "Plan The Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -112
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
