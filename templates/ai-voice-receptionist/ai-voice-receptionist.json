      "id": "f5511d85-ca32-41ee-b46a-dc00fffab5af",
      "name": "Read Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "position": [
        1440,
        -112
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Finds the free slots in the calendar and, for a booking, checks the requested time is open.\n// Busy = any event that is not cancelled and not marked \"free\". All-day events block the whole day.\nconst s = $('Your Settings').first().json;\nconst r = $('Read The Request').first().json;\nconst plan = $('Plan The Search').first().json;\nconst tz = s.timezone || 'America/New_York';\nconst slotMin = Math.max(10, parseInt(s.appointmentMinutes, 10) || 30);\nconst notice = Math.max(0, parseInt(s.minimumNoticeMinutes, 10) || 60);\nconst openDays = String(s.openDays || 'Mon,Tue,Wed,Thu,Fri').split(',').map(x => x.trim().slice(0, 3).toLowerCase());\nconst hm = (t, d) => { const m = String(t || d).match(/(\\d{1,2}):(\\d{2})/); return m ? [Number(m[1]), Number(m[2])] : hm(d, d); };\nconst [oh, om] = hm(s.openTime, '09:00'), [ch, cm] = hm(s.closeTime, '17:00');\nconst now = DateTime.now().setZone(tz);\nconst busy = $input.all().map(i => i.json)\n  .filter(e => e && e.start && e.status !== 'cancelled' && e.transparency !== 'transparent')\n  .map(e => ({ s: DateTime.fromISO(e.start.dateTime || e.start.date, { zone: tz }), e: DateTime.fromISO(e.end.dateTime || e.end.date, { zone: tz }) }))\n  .filter(b => b.s.isValid && b.e.isValid);\nconst isFree = (st, en) => !busy.some(b => st < b.e && en > b.s);\nconst isOpenDay = (d) => openDays.includes(d.toFormat('ccc').toLowerCase());\nconst inHours = (st, en) => { const o = st.set({ hour: oh, minute: om, second: 0, millisecond: 0 }), c = st.set({ hour: ch, minute: cm, second: 0, millisecond: 0 }); return st >= o && en <= c; };\nconst say = (d) => d.toFormat('h:mm a').replace(':00', '');\nconst sayDay = (d) => d.hasSame(now, 'day') ? 'today' : d.hasSame(now.plus({ days: 1 }), 'day') ? 'tomorrow' : d.toFormat('cccc, LLLL d');\nconst slotsOn = (day) => {\n  if (!isOpenDay(day)) return [];\n  const out = [];\n  for (let st = day.set({ hour: oh, minute: om, second: 0, millisecond: 0 }); ; st = st.plus({ minutes: slotMin })) {\n    const en = st.plus({ minutes: slotMin });\n    if (!inHours(st, en)) break;\n    if (st >= now.plus({ minutes: notice }) && isFree(st, en)) out.push(st);\n  }\n  return out;\n};\nconst first = DateTime.fromISO(plan.windowStart, { zone: tz }).startOf('day');\nconst last = DateTime.fromISO(plan.windowEnd, { zone: tz });\nconst nextOpenings = () => { for (let d = first; d <= last; d = d.plus({ days: 1 })) { const sl = slotsOn(d); if (sl.length) return { day: d, slots: sl }; } return null; };\n\nif (r.action === 'check_availability') {\n  const asked = slotsOn(first), found = asked.length ? { day: first, slots: asked } : nextOpenings();\n  if (!found) return [{ json: { bookOk: false, speak: `I'm sorry, there are no openings in the next ${s.daysToSearch || 7} days. I can take a message and have the team call you back.` } }];\n  const pick = found.slots.length <= 5 ? found.slots : [0, 1, 2, 3, 4].map(i => found.slots[Math.floor(i * (found.slots.length - 1) / 4)]);\n  const lead = plan.pastAsked ? `${plan.pastAsked} has already passed. ` : (asked.length || !String(r.args.date || r.args.day || '').trim() ? '' : `${sayDay(first)} is fully booked. `);\n  const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);\n  return [{ json: { bookOk: false, slots: pick.map(x => x.toISO()), speak: `${lead}${cap(sayDay(found.day))} I have ${pick.map(say).join(', ').replace(/, ([^,]*)$/, ' or $1')}. Which works best?` } }];\n}\n\n// book_appointment\nconst a = r.args, name = String(a.name || a.customer_name || '').trim(), phone = String(a.phone || a.phone_number || '').trim();\nconst email = String(a.email || '').trim().toLowerCase(), service = String(a.service || a.reason || 'Appointment').trim();\nif (!name) return [{ json: { bookOk: false, speak: 'Before I book it, may I have your name?' } }];\nif (!phone && !email) return [{ json: { bookOk: false, speak: 'What is the best phone number to reach you?' } }];\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) return [{ json: { bookOk: false, speak: 'That email did not look right. Could you spell it for me?' } }];\nlet st = a.start ? DateTime.fromISO(String(a.start), { zone: tz }) : DateTime.fromISO(`${a.date}T${String(a.time || '').padStart(5, '0')}`, { zone: tz });\nif (!st.isValid) return [{ json: { bookOk: false, speak: 'What day and time would you like?' } }];\nst = st.setZone(tz);\nconst en = st.plus({ minutes: slotMin });\nconst sameDay = slotsOn(st.startOf('day'));\nconst alt = () => { const o = sameDay.length ? { day: st.startOf('day'), slots: sameDay } : nextOpenings(); return o ? ` I do have ${sayDay(o.day)} at ${o.slots.slice(0, 3).map(say).join(', ').replace(/, ([^,]*)$/, ' or $1')}.` : ''; };\nif (st < now.startOf('day')) return [{ json: { bookOk: false, speak: `${st.toFormat('LLLL d')} has already passed.${alt()}` } }];\nif (st < now.plus({ minutes: notice })) return [{ json: { bookOk: false, speak: `That time is too soon for us to prepare.${alt()}` } }];\nif (!isOpenDay(st) || !inHours(st, en)) return [{ json: { bookOk: false, speak: `We are not open then.${alt()}` } }];\nif (!isFree(st, en)) return [{ json: { bookOk: false, speak: `That time was just taken.${alt()}` } }];\nreturn [{ json: {\n  bookOk: true, name, phone, email, service, notes: String(a.notes || '').trim(),\n  start: st.toISO(), end: en.toISO(), whenText: `${st.toFormat('cccc, LLLL d')} at ${say(st)}`,\n  speak: `You're all set, ${name.split(' ')[0]}. I've booked your ${service.toLowerCase()} for ${sayDay(st)} at ${say(st)}.${email ? ' A confirmation is on its way to your email.' : ''}`,\n} }];\n"
      },
