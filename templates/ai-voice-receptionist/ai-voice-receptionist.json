    {
      "parameters": {
        "jsCode": "// Checks a message has enough to call the person back, and shapes the row and the owner's email.\nconst r = $('Read The Request').first().json, a = r.args;\nconst name = String(a.name || a.customer_name || '').trim(), phone = String(a.phone || a.phone_number || '').trim();\nconst reason = String(a.reason || a.message || a.notes || '').trim();\nif (!phone) return [{ json: { ok: false, speak: 'What number should we call you back on?' } }];\nreturn [{ json: { ok: true, name: name || 'Unknown caller', phone, reason: reason || '(no details given)', platform: r.platform,\n  receivedAt: $now.toFormat('yyyy-MM-dd HH:mm'),\n  speak: `Thanks${name ? ', ' + name.split(' ')[0] : ''}. I've passed your message to the team and someone will call you back on ${phone}.` } }];\n"
      },
