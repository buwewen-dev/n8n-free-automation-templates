    {
      "parameters": {
        "jsCode": "// Reads a request from any voice platform and turns it into { platform, action, args }.\n// Vapi tool calls, Vapi end-of-call reports, Retell custom functions and call events, ElevenLabs server tools\n// (put ?action=... on the tool URL) and ElevenLabs post-call webhooks, or a plain { \"action\": ..., ... } POST.\nconst s = $('Your Settings').first().json;\nconst req = $('Call Comes In').first().json;\nconst body = req.body || {};\nconst q = req.query || {};\nconst h = req.headers || {};\nconst parseArgs = (a) => { if (!a) return {}; if (typeof a === 'string') { try { return JSON.parse(a); } catch (e) { return {}; } } return a; };\nlet platform = 'generic', toolCallId = '', action = '', args = {};\nconst m = body.message || {};\nif (m.type === 'tool-calls' || m.toolCallList || m.toolCalls) {\n  platform = 'vapi';\n  const call = (m.toolCallList || m.toolCalls || [])[0] || {};\n  toolCallId = call.id || '';\n  action = (call.function && call.function.name) || call.name || '';\n  args = parseArgs((call.function && call.function.arguments) || call.arguments || call.parameters);\n} else if (m.type === 'end-of-call-report') {\n  platform = 'vapi'; action = 'call_summary';\n  const cust = m.customer || (m.call && m.call.customer) || {};\n  args = { summary: m.summary || (m.analysis && m.analysis.summary) || '', transcript: m.transcript || '', caller: cust.number || '', durationSeconds: m.durationSeconds || '' };\n} else if (body.event === 'call_ended' || body.event === 'call_analyzed') {\n  platform = 'retell'; action = 'call_summary';\n  const c = body.call || {};\n  args = { summary: (c.call_analysis && c.call_analysis.call_summary) || '', transcript: c.transcript || '', caller: c.from_number || '', durationSeconds: c.duration_ms ? Math.round(c.duration_ms / 1000) : '' };\n} else if (typeof body.name === 'string' && body.args !== undefined) {\n  platform = 'retell'; action = body.name; args = parseArgs(body.args);\n} else if (body.type === 'post_call_transcription') {\n  platform = 'elevenlabs'; action = 'call_summary';\n  const d = body.data || {}, md = d.metadata || {};\n  args = { summary: (d.analysis && d.analysis.transcript_summary) || '',\n           transcript: Array.isArray(d.transcript) ? d.transcript.map(t => `${t.role}: ${t.message}`).join('\\n') : '',\n           caller: (md.phone_call && md.phone_call.external_number) || '', durationSeconds: md.call_duration_secs || '' };\n} else {\n  platform = q.action ? 'elevenlabs' : 'generic';\n  action = String(q.action || body.action || body.tool || '');\n  args = { ...body }; delete args.action; delete args.tool;\n}\naction = String(action).toLowerCase().replace(/[^a-z_]/g, '');\nconst secret = String(s.secretKey || '').trim();\nconst given = String(h['x-receptionist-key'] || q.key || '').trim();\nreturn [{ json: { platform, toolCallId, action, args: args || {}, authorized: !secret || given === secret } }];\n"
      },
