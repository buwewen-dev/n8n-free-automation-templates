      "parameters": {
        "jsCode": "// Answers in the shape each platform expects. Vapi wants results[] keyed by the tool call id; the others take any JSON.\nconst r = $('Read The Request').first().json;\nlet speak = String($json.speak || 'Done.');\nspeak = speak.charAt(0).toUpperCase() + speak.slice(1);                    // \"tomorrow I have...\" -> \"Tomorrow I have...\"\nreturn [{ json: r.platform === 'vapi' ? { results: [{ toolCallId: r.toolCallId, result: speak }] } : { result: speak } }];\n"
      },
